<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="SeleniumFrameworkSuite" verbose="1">

    <!-- Global parameters -->
    <parameter name="browser" value="chrome"/>

    <!-- Allure reporting listener -->
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!-- Run all tests in the tests package -->
    <test name="AllTests">
        <packages>
            <!-- Update this to match your actual package structure -->
            <package name="WesRegression"/>
            <!-- Or use wildcards for all subpackages -->
            <!-- <package name="tests.*"/> -->
        </packages>
    </test>

</suite>